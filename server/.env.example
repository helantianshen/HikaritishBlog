APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@127.0.0.1:5432/hikaritish_blog?sslmode=disable
CORS_ORIGINS=http://localhost:3000
ADMIN_TOKEN=replace-with-a-long-random-token
SHUTDOWN_TIMEOUT=10s

RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=replace-me
RUSTFS_SECRET_KEY=replace-me
RUSTFS_BUCKET=blog-images
RUSTFS_PUBLIC_BASE_URL=https://oss.guyuan-v.top/blog-images
RUSTFS_USE_PATH_STYLE=true
MAX_IMAGE_BYTES=10485760
